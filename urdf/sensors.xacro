<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <geometry><box size="0.05 0.05 0.02"/></geometry>
      <material name="Red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision><geometry><box size="0.05 0.05 0.02"/></geometry></collision>
    <xacro:box_inertia m="0.1" x="0.05" y="0.05" z="0.02"/>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- LIDAR 2D -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.05" length="0.06"/></geometry>
      <material name="Red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision><geometry><cylinder radius="0.05" length="0.06"/></geometry></collision>
    <xacro:cylinder_inertia m="0.125" r="0.05" h="0.06"/>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <!-- CÁMARA DE PROFUNDIDAD -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.10 0.03"/></geometry>
      <material name="Red"><color rgba="1 0 0 1"/></material>
    </visual>
    <collision><geometry><box size="0.02 0.10 0.03"/></geometry></collision>
    <xacro:box_inertia m="0.035" x="0.02" y="0.10" z="0.03"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="0.20 0 0.05" rpy="0 0 0"/>
  </joint>
  <link name="camera_depth_frame"/>
  <joint name="camera_depth_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
    <origin xyz="0.01 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>

  <!-- ===== Sensores de Gazebo =====
       Los sistemas Sensors e Imu van en el mundo (.sdf), no aquí. -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.02</stddev></noise></y>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- laser_noise_std se puede subir para responder la pregunta de P4 -->
  <xacro:property name="laser_noise_std" value="0.01"/>
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.0</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>25.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise type="gaussian"><mean>0.0</mean><stddev>${laser_noise_std}</stddev></noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_depth_frame">
    <sensor name="depth_camera" type="depth_camera">
      <topic>camera/depth/image_raw</topic>
      <gz_frame_id>camera_depth_frame</gz_frame_id>
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>320</width><height>240</height><format>R_FLOAT32</format></image>
        <clip><near>0.05</near><far>8.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>
